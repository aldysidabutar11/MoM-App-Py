# ---------------------------------------------------------------------------
# MoM-IGD .gitattributes
#
# WHY THIS FILE IS MANDATORY
# The development machine has `core.autocrlf = true` (verified in Phase 0).
# Without explicit rules, Git would apply CRLF/LF translation to any file it
# guesses is text. For this project that would silently corrupt FLAC/WAV
# audio, SQLite databases, ONNX/GGUF model files and binary evaluation
# fixtures, and it would invalidate every SHA-256 checksum in the audio
# manifest and the model registry.
#
# Rule: text files are normalised to LF in the repository and checked out with
# native line endings on Windows; every binary format below is marked -text so
# Git never touches its bytes.
# ---------------------------------------------------------------------------

# Default: let Git detect text and normalise it to LF in the repository.
* text=auto

# --- Source and configuration (explicit text, LF in repo) -----------------
*.py      text diff=python
*.pyi     text diff=python
*.toml    text
*.cfg     text
*.ini     text
*.json    text
*.jsonl   text
*.yaml    text
*.yml     text
*.md      text diff=markdown
*.txt     text
*.rst     text
*.sql     text
*.html    text diff=html
*.css     text diff=css
*.js      text
*.svg     text
*.rttm    text
*.vtt     text
*.srt     text
*.csv     text
.gitignore      text
.gitattributes  text
.editorconfig   text

# --- Windows-only scripts must keep CRLF ----------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Shell scripts must keep LF -------------------------------------------
*.sh text eol=lf

# ===========================================================================
